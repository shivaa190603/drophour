# DropHour - Environment Variables
# Copy this file to .env to connect to your live Supabase project

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable API Key (safe for frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Note: DropHour works automatically out of the box in local demo mode
# without any environment variables configured!
