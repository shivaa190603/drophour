# ==============================================================================
# DropHour - Secure Environment Configuration
# Copy this file to .env and insert your project keys
# NEVER commit your .env file to public repositories!
# ==============================================================================

# Database Node 1: Primary Supabase Project (Required for live mode)
VITE_SUPABASE_URL=https://your-primary-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Database Node 2: Secondary Supabase Free-Tier Project (Optional / 50MB+ load balance)
VITE_SUPABASE_URL_2=
VITE_SUPABASE_ANON_KEY_2=

# Database Node 3: Third Supabase Free-Tier Project (Optional)
VITE_SUPABASE_URL_3=
VITE_SUPABASE_ANON_KEY_3=

# Database Node 4: Fourth Supabase Free-Tier Project (Optional)
VITE_SUPABASE_URL_4=
VITE_SUPABASE_ANON_KEY_4=

# Database Node 5: Fifth Supabase Free-Tier Project (Optional)
VITE_SUPABASE_URL_5=
VITE_SUPABASE_ANON_KEY_5=

# Razorpay Payments Gateway Key
VITE_RAZORPAY_KEY_ID=
# Razorpay Key Secret (Server-only, no VITE_ prefix)
RAZORPAY_KEY_SECRET=

# Discord Webhook for Security Audits & System Alerts (Optional)
DISCORD_WEBHOOK_URL=

